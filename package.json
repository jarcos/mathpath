{
  "name": "mathpath",
  "version": "0.13.0",
  "description": "MathPath - an offline e-learning desktop app to learn maths from pre-university to machine learning.",
  "author": "Jose Arcos",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --test \"test/*.test.js\"",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:glossary": "node scripts/verify-glossary.mjs",
    "verify:code": "python3 scripts/verify-code.py",
    "verify:pyodide": "node scripts/verify-pyodide.mjs",
    "verify": "npm run verify:content && npm run verify:glossary && npm run verify:code && npm run verify:pyodide",
    "setup:pyodide": "node scripts/copy-pyodide.mjs",
    "setup:pyodide:wheels": "node scripts/fetch-pyodide-wheels.mjs",
    "postinstall": "node scripts/copy-pyodide.mjs",
    "predist": "npm run verify && npm run build",
    "dist": "electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "i18next": "^23.12.2",
    "katex": "^0.16.11",
    "mathjs": "^13.0.3",
    "pyodide": "^0.26.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.1",
    "vite": "^5.3.5"
  }
}
